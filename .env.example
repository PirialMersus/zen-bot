# Токен Telegram бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Юзернейм бота (опционально)
BOT_USERNAME=your_bot_username

# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# Secret key для подписи JWT токенов (минимум 32 символа)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long

# Telegram ID создателя/администратора бота
CREATOR_ID=your_telegram_id

# Окружение: development | production | test
NODE_ENV=development

# Порт для Express сервера
PORT=3000

# Разрешенные CORS origins через запятую (например: http://localhost:3000,https://app.example.com)
ALLOWED_ORIGINS=

# URL для health checks (опционально, для внешнего мониторинга)
HEALTHCHECKS_URL=
