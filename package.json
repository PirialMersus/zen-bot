{
  "name": "zen-bot",
  "type": "module",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed:pointers": "node scripts/seedPointers.js",
    "seed:pointers:ru": "node scripts/seedPointers.js",
    "seed:pointers:en": "node scripts/seedPointersEn.js",
    "seed:pointers:uk": "node scripts/seedPointersUk.js",
    "seed:pointers:es": "node scripts/seedPointersEs.js",
    "reindex:pointers": "node scripts/reindexPointers.js",
    "sync:pointers": "node scripts/syncAllPointers.js",
    "pointer:remove": "node scripts/removePointer.js",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.1.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.10.0",
    "vitest": "^3.2.7"
  }
}
